{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schema/manifest.schema.json",
  "title": "ai-brain MANIFEST.yaml",
  "type": "object",
  "required": ["schema_version", "content_version", "generated_by", "sensitivity_default", "budgets", "sources", "adapters", "private_bundle"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string"},
    "generated_by": {"type": "string"},
    "owner_role": {"type": "string"},
    "git_branch": {"type": "string"},
    "sensitivity_default": {"enum": ["public", "local"]},
    "budgets": {
      "type": "object",
      "required": ["ai_brief_tokens", "always_inject_tokens", "max_card_lines"],
      "properties": {
        "ai_brief_tokens": {"type": "integer", "minimum": 500},
        "always_inject_tokens": {"type": "integer", "minimum": 500},
        "max_card_lines": {"type": "integer", "minimum": 20}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "adapters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "private_bundle": {
      "type": "object",
      "required": ["path", "encrypted", "passphrase_env", "restore_to"],
      "properties": {
        "path": {"type": "string"},
        "encrypted": {"const": true},
        "passphrase_env": {"type": "string"},
        "restore_to": {"type": "string"}
      }
    }
  }
}
