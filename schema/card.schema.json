{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schema/card.schema.json",
  "title": "ai-brain card frontmatter",
  "type": "object",
  "required": ["id", "title", "type", "scope", "status", "version", "updated", "review_by", "sensitivity", "load", "summary", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 2},
    "type": {"enum": ["preference", "rule", "prompt", "context", "workflow", "index"]},
    "scope": {"type": "string", "pattern": "^(global|project:[a-z0-9-]+|tool:[a-z0-9-]+)$"},
    "status": {"enum": ["active", "deprecated", "archived"]},
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "review_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sensitivity": {"enum": ["public", "local"]},
    "load": {"enum": ["always", "on-demand", "never"]},
    "summary": {"type": "string", "maxLength": 150},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
